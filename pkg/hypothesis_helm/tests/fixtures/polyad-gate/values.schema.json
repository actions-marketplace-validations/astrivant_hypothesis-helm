{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Polyad CRD and named resource chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable instance rendering and, as a dependency, CRD inclusion."
    },
    "global": {
      "type": "object",
      "x-polyad-freeform": true,
      "description": "Shared Helm values inherited from the parent chart."
    },
    "variables": {
      "type": "object",
      "x-polyad-freeform": true,
      "description": "Administrator-defined inputs available to tpl expressions through .Values.variables."
    },
    "maxTplPasses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "Bound reference resolution; cyclic or unresolved tpl expressions fail."
    },
    "gates": {
      "type": "object",
      "description": "Gate instances keyed by Kubernetes name; fields accept tpl and use CRD defaults.",
      "patternProperties": {
        "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$": {
          "type": "object",
          "properties": {
            "metadata": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 253,
                          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                        },
                        {
                          "type": "string",
                          "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                        }
                      ]
                    },
                    "namespace": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 63,
                          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                        },
                        {
                          "type": "string",
                          "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                        }
                      ]
                    },
                    "labels": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "string",
                                "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                              }
                            ]
                          }
                        },
                        {
                          "type": "string",
                          "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                        }
                      ]
                    },
                    "annotations": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "string",
                                "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                              }
                            ]
                          }
                        },
                        {
                          "type": "string",
                          "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                        }
                      ]
                    }
                  },
                  "required": []
                },
                {
                  "type": "string",
                  "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                }
              ]
            },
            "spec": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "expression": {
                      "anyOf": [
                        {
                          "type": "object",
                          "x-kubernetes-preserve-unknown-fields": true,
                          "required": [
                            "operator"
                          ],
                          "description": "Serialized Gate expression with operator, optional operands and signal name. Operators are signal, and, or, not, xor and nxor. Signals use NODE.started, NODE.ready, NODE.completed or NODE.failed; absent observations remain unknown."
                        },
                        {
                          "type": "string",
                          "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                        }
                      ],
                      "description": "Serialized Gate expression with operator, optional operands and signal name. Operators are signal, and, or, not, xor and nxor. Signals use NODE.started, NODE.ready, NODE.completed or NODE.failed; absent observations remain unknown."
                    },
                    "delaySeconds": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 315360000,
                          "description": "Standalone admission delay after dependencies are observed. Each graph instance persists its own deadline in status; waits do not occupy workers or slots."
                        },
                        {
                          "type": "string",
                          "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                        }
                      ],
                      "description": "Standalone admission delay after dependencies are observed. Each graph instance persists its own deadline in status; waits do not occupy workers or slots."
                    }
                  },
                  "description": "Reusable Boolean expression or delay gate controlling admission to the next vertex.",
                  "x-kubernetes-validations": [
                    {
                      "rule": "has(self.expression) != has(self.delaySeconds)",
                      "message": "Gate requires exactly one of expression or delaySeconds"
                    }
                  ],
                  "required": [],
                  "additionalProperties": false
                },
                {
                  "type": "string",
                  "pattern": "\\{\\{[\\s\\S]*\\}\\}"
                }
              ],
              "description": "Reusable Boolean expression or delay gate controlling admission to the next vertex."
            }
          },
          "required": [
            "spec"
          ],
          "description": "Define a Boolean or delay gate. Instances keep delay observations on their containing graph.",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
